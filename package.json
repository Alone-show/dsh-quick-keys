{
  "name": "dsh-quick-keys",
  "version": "1.0.1",
  "type": "module",
  "description": "DSH 插件：/new 命令新建对话，Shift+Tab 一键切换计划模式。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plan-mode",
    "shortcut",
    "keyboard"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "icon.svg",
    "assets/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alone-show/dsh-quick-keys.git"
  },
  "homepage": "https://github.com/Alone-show/dsh-quick-keys#readme",
  "bugs": {
    "url": "https://github.com/Alone-show/dsh-quick-keys/issues"
  }
}
